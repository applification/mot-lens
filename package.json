{
  "name": "mot-lens",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "bun run build && bun run check && bun run test && bun run test:e2e",
    "start": "node --env-file-if-exists=.env --import tsx apps/mcp/src/local.ts",
    "control": "tsx scripts/control.ts",
    "package:plugin": "tsx scripts/package-plugin.ts",
    "verify:hosted": "tsx scripts/verify-hosted.ts"
  },
  "dependencies": {
    "@mot-lens/domain": "workspace:*",
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "hono": "^4.12.0",
    "@hono/node-server": "^1.19.0",
    "zod": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "turbo": "^2.8.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.0.0",
    "wrangler": "4.149.0"
  }
}
