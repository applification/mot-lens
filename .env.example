# Local Node development uses .env; Wrangler local development uses .dev.vars.
# Leave all five empty for explicit sample mode. Never use VITE_ for credentials.
DVSA_API_KEY=
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
# Copy the tenant-specific Microsoft Entra URL and scope issued by DVSA.
DVSA_TOKEN_URL=
DVSA_SCOPE=

# Optional Node port (development preview expects 8787).
PORT=8787
# CLI only: alternate public/local endpoint. Do not include credentials in URLs.
MOT_LENS_ENDPOINT=http://127.0.0.1:8787/mcp

# Worker-only optional variables configured through Wrangler, not the Vite build:
# WIDGET_DOMAIN=<unique UI origin required by the intended host/public review>
# OPENAI_VERIFICATION_TOKEN=<exact token issued by the OpenAI submission portal>
